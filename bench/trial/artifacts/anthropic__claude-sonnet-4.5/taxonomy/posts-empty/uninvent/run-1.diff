+import * as React from "react"
+
+import { Button } from "@/components/ui/button"
+import { Skeleton } from "@/components/ui/skeleton"
+import { cn } from "@/lib/utils"
+
+export interface PostsEmptyProps extends React.HTMLAttributes<HTMLDivElement> {
+  loading?: boolean
+}
+
+const PostsEmpty = React.forwardRef<HTMLDivElement, PostsEmptyProps>(
+  ({ className, loading, ...props }, ref) => {
+    if (loading) {
+      return (
+        <div
+          ref={ref}
+          className={cn("flex flex-col gap-4 p-8", className)}
+          {...props}
+        >
+          <Skeleton className="h-32 w-full" />
+        </div>
+      )
+    }
+
+    return (
+      <div
+        ref={ref}
+        className={cn(
+          "flex flex-col items-center justify-center gap-4 p-8 text-center",
+          className
+        )}
+        {...props}
+      >
+        <p className="text-muted-foreground">No posts yet.</p>
+        <Button>New post</Button>
+      </div>
+    )
+  }
+)
+PostsEmpty.displayName = "PostsEmpty"
+
+export { PostsEmpty }
