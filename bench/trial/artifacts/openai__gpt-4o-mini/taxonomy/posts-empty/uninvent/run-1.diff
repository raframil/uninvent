+interface PostsEmptyProps {
+  loading?: boolean;
+}
+
+const PostsEmpty: React.FC<PostsEmptyProps> = ({ loading }) => {
+  if (loading) {
+    return <Skeleton className="h-48 w-full" />;
+  }
+
+  return (
+    <div className="flex flex-col items-center justify-center text-center">
+      <p>No posts yet.</p>
